<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to appSettings.config (same folder) on each server. That file is ignored by Git.
  Generate the signing key (PowerShell 7):
    [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
-->
<appSettings>
  <add key="Portal.ConnectionString" value="Server=SQLSERVER;Database=SupplierPortal;User ID=app_portal;Password=***;Encrypt=True;TrustServerCertificate=True" />
  <add key="Security.LinkSigningKey" value="" />
</appSettings>
