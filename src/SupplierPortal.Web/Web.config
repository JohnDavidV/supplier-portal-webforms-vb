<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Secrets live in Config\appSettings.config, which is NOT in source control (see
    Config\appSettings.example.config). Keys defined there override the ones below.
    Without Portal.ConnectionString the site runs in demo mode with fictional data.
  -->
  <appSettings file="Config\appSettings.config">
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="Security.Pbkdf2Iterations" value="310000" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="1024" />
    <globalization culture="es-CO" uiCulture="es-CO" requestEncoding="utf-8" responseEncoding="utf-8" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="30" slidingExpiration="true"
             cookieless="UseCookies" protection="All" name=".SUPPLIERAUTH" requireSSL="false" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" cookieless="UseCookies" timeout="30" cookieName="sp_session" />
    <!-- requireSSL is switched to true by Web.Release.config for production -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Static" enableViewStateMac="true" viewStateEncryptionMode="Always" />
    <trace enabled="false" />
  </system.web>

  <!-- Public resources -->
  <location path="Login.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Certificate.ashx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Error.aspx"><system.web><authorization><allow users="*" /></authorization></system.web></location>
  <location path="Content"><system.web><authorization><allow users="*" /></authorization></system.web></location>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Never serve the folder with secrets, sources or SQL scripts -->
        <hiddenSegments>
          <add segment="Config" />
          <add segment="sql" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".vb" allowed="false" />
          <add fileExtension=".vbproj" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
