<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASP.NET WebForms site (.NET Framework 4.8) in an SDK-style project, so it builds with
    `dotnet build` (and in CI) without Visual Studio. The output goes to .\bin, which is
    exactly what IIS / IIS Express expect for a WebForms application root.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>SupplierPortal.Web</RootNamespace>
    <AssemblyName>SupplierPortal.Web</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupplierPortal.Core\SupplierPortal.Core.vbproj" />
  </ItemGroup>

</Project>
